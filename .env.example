# Data adapter: "mock" (default) reads /src/data/mock, "api" hits the clinic endpoint stub.
VITE_DATA_SOURCE=mock

# Remote control: unset/empty = single-device (wall screen + clicker, local state).
# "ws" enables the /server/remote-relay.ts tablet relay over the clinic LAN.
VITE_REMOTE=

# Relay endpoint used by the wall screen + /remote tablet route when VITE_REMOTE=ws.
VITE_RELAY_URL=ws://localhost:8787
