{
  "name": "acko-clinic-body-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Acko Clinic post-screening 3D body consultation app (kiosk + tablet remote).",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "verify:body-fit": "/Applications/Blender.app/Contents/MacOS/Blender -b --python scripts/verify_body_fit.py",
    "assets:build": "cd asset-pipeline && bash 01_fetch.sh && python3 02_audit_licenses.py && /Applications/Blender.app/Contents/MacOS/Blender -b -P 03_build_glb.py && /Applications/Blender.app/Contents/MacOS/Blender -b -P 03b_build_shells.py && python3 04_validate.py",
    "assets:shells": "cd asset-pipeline && /Applications/Blender.app/Contents/MacOS/Blender -b -P 03b_build_shells.py",
    "relay": "tsx server/remote-relay.ts"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.16.3",
    "postprocessing": "^6.36.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "three": "^0.169.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3",
    "ws": "^8.18.0"
  }
}
